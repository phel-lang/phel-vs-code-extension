{
    "comments": {
        "lineComment": "#",
        "blockComment": ["#|", "|#"]
    },
    "brackets": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"]
    ],
    "autoClosingPairs": [
        { "open": "{", "close": "}" },
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "#|", "close": "|#" },
        { "open": "#{", "close": "}" },
        { "open": "|(", "close": ")" }
    ],
    "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["\"", "\""]
    ],
    "wordPattern": "[^\\s\\(\\)\\[\\]\\{\\}\"'`,;#]+",
    "indentationRules": {
        "increaseIndentPattern": "^.*\\([^)]*$|^.*\\[[^\\]]*$|^.*\\{[^}]*$",
        "decreaseIndentPattern": "^\\s*[)\\]\\}]"
    }
}
