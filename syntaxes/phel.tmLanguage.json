{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Phel",
	"patterns": [
		{
			"include": "#multiline-comment"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#regexp"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#reader-conditional"
		},
		{
			"include": "#short-fn"
		},
		{
			"include": "#parens"
		},
		{
			"include": "#brackets"
		},
		{
			"include": "#braces"
		},
		{
			"include": "#sets"
		},
		{
			"include": "#tagged-literal"
		},
		{
			"include": "#metadata"
		},
		{
			"include": "#char"
		},
		{
			"include": "#readermac"
		},
		{
			"include": "#keysym"
		},
		{
			"include": "#literal"
		},
		{
			"include": "#number"
		},
		{
			"include": "#interop"
		},
		{
			"include": "#corelib"
		},
		{
			"include": "#symbol"
		}
	],
	"repository": {
		"corelib": {
			"patterns": [
				{
					"name": "keyword.control.phel",
					"match": "(?<=\\(|\\{|\\[|\\s)(with-isolated-reporters|with-isolated-stats|with-output-buffer|with-mock-wrapper|unquote-splicing|extend-protocol|compiled-router|definterface\\*?|defexception\\*?|defenum\\*?|with-bindings|future-fiber|with-redefs|with-config|symbol-info|extend-type|explain-sym|defprotocol|with-mocks|with-open|when-first|defstruct\\*?|when-some|instance\\?|defrecord|defmethod|defmacro-|when-not|when-let|prefer-method|prefers|lazy-seq|lazy-cat|hash-map|defmulti|defmacro|unquote|testing|some->>|set-var|require|if-some|foreach|finally|dotrace|dotimes|deftrace|defbench|deftype|deftest|defspec|declare|cond->>|comment|break|binding|vector|source|some->|reify\\*?|if-not|if-let|future|cond->|concat|assert|throw|recur|quote|match|letfn|in-ns|doseq|dofor|deref|delay|defn-|condp|catch|async|apply|while|when|time|loop|load|list|html|dbg|doto|defonce|defn|def-|conj|cond|case|aset|set!|as->|var|use|try|pop|new|let|for|doc|dir|def|are|and|->>|or|ns|is|if|fn|do|->)(?=\\s|\\)|\\]|\\})"
				},
				{
					"name": "keyword.control.phel",
					"match": "(?<=\\(|\\{|\\[|\\s)(php\\/[^\\s\\#\\(\\)\\{\\}\\[\\]\\'\\\"\\,\\`]+)(?=\\s|\\)|\\]|\\})"
				}
			]
		},
		"number": {
			"comment": "Mirrors phel-lang's AtomParser numeric regexes; the suffixed / radix / ratio forms must precede the plain decimal rule so `16rFF` is not chewed as `16`.",
			"patterns": [
				{
					"match": "##(?:-?Inf|NaN)(?![A-Za-z0-9_\\-])",
					"name": "constant.language.symbolic-number.phel"
				},
				{
					"match": "[+-]?(?:2|[3-9]|[12][0-9]|3[0-6])[rR][0-9a-zA-Z]+(?:_[0-9a-zA-Z]+)*",
					"name": "constant.numeric.radix.phel"
				},
				{
					"match": "[+-]?[0-9]+(?:_[0-9]+)*(?:\\.[0-9]+(?:_[0-9]+)*)?(?:[eE][+-]?[0-9]+)?M(?![A-Za-z0-9_\\-])",
					"name": "constant.numeric.bigdecimal.phel"
				},
				{
					"match": "[+-]?[0-9]+(?:_[0-9]+)*N(?![A-Za-z0-9_\\-])",
					"name": "constant.numeric.bigint.phel"
				},
				{
					"match": "[+-]?[0-9]+(?:_[0-9]+)*/[0-9]+(?:_[0-9]+)*(?![A-Za-z0-9_\\-])",
					"name": "constant.numeric.ratio.phel"
				},
				{
					"match": "[+-]?0[xX][0-9a-fA-F]+(?:_[0-9a-fA-F]+)*",
					"name": "constant.numeric.hex.phel"
				},
				{
					"match": "[+-]?0[bB][01]+(?:_[01]+)*",
					"name": "constant.numeric.binary.phel"
				},
				{
					"match": "[+-]?0(?:_?[0-7]+)+",
					"name": "constant.numeric.octal.phel"
				},
				{
					"match": "(?x)\n(?:\n  [+-]?(?:[0-9]+(?:_[0-9]+)*)?(\\.)[0-9]+(?:_[0-9]+)*(?:[eE][+-]?[0-9]+(?:_[0-9]+)*)?| # .3\n  [+-]?[0-9]+(?:_[0-9]+)*(\\.)(?:[0-9]+(?:_[0-9]+)*)?(?:[eE][+-]?[0-9]+(?:_[0-9]+)*)?| # 3.\n  [+-]?[0-9]+(?:_[0-9]+)*[eE][+-]?[0-9]+(?:_[0-9]+)*                                   # 2e-3\n)",
					"name": "constant.numeric.decimal.phel",
					"captures": {
						"1": {
							"name": "punctuation.separator.decimal.period.phel"
						},
						"2": {
							"name": "punctuation.separator.decimal.period.phel"
						}
					}
				},
				{
					"match": "([+-]?\\d+(?:_\\d+)*)",
					"name": "constant.numeric.decimal.phel"
				}
			]
		},
		"literal": {
			"patterns": [
				{
					"match": "(?<=^|\\s|\\(|\\[|\\{)(nil)(?=(\\s|\\)|\\]|\\}))",
					"name": "constant.language.nil.phel"
				},
				{
					"match": "(?<=^|\\s|\\(|\\[|\\{)(true|false)(?=(\\s|\\)|\\]|\\}))",
					"name": "constant.language.boolean.phel"
				}
			]
		},
		"readermac": {
			"patterns": [
				{
					"name": "comment.block.phel",
					"match": "#_"
				},
				{
					"name": "punctuation.other.phel",
					"match": "#'"
				},
				{
					"name": "punctuation.other.unquote-splicing.phel",
					"match": "~@"
				},
				{
					"comment": "A comma is plain whitespace, not unquote. `,` and `,@` lost their reader meaning before 1.0 and are not coming back, so `` `(foo ,x) `` quotes `x` rather than unquoting it. Scoped as a separator so a theme can dim it the way it dims whitespace, and deliberately not as a reader macro.",
					"name": "punctuation.separator.comma.phel",
					"match": ","
				},
				{
					"name": "punctuation.other.phel",
					"match": "[~`'^]|@(?![({\\[])"
				}
			]
		},
		"keysym": {
			"name": "variable.other.constant.phel",
			"match": ":[^\\s\\#\\(\\)\\{\\}\\[\\]\\'\\\"\\,\\`]+"
		},
		"symbol": {
			"comment": "Mirrors the lexer's atom rule: a trailing `#` is part of the symbol (gensym syntax, e.g. `x#`), so it must not fall through to the bare-`#` comment rule. An apostrophe is likewise part of the symbol in any position but the first (`a'`, `foo''`), while a leading one is the quote reader macro (`'sym`) and is left to #readermac.",
			"name": "meta.symbol.phel",
			"match": "(?<![\\-])[^\\s\\#\\(\\)\\{\\}\\[\\]\\'\\\"\\,\\`][^\\s\\#\\(\\)\\{\\}\\[\\]\\\"\\,\\`]*\\#?"
		},
		"char": {
			"comment": "Character literals: \\a, \\A, \\1, \\(, \\space, \\newline, \\uNNNN, \\oNNN. The lookahead lets `\\Phel\\Lang\\Symbol` stay a symbol, matching the lexer.",
			"name": "constant.character.phel",
			"match": "\\\\(?:space|newline|tab|formfeed|backspace|return|u[0-9a-fA-F]{4}|o[0-7]{1,3}|[^\\s])(?![A-Za-z0-9_\\-\\\\])"
		},
		"regexp": {
			"name": "string.regexp.phel",
			"begin": "(#)\"",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.string.begin.phel"
				},
				"1": {
					"name": "punctuation.definition.tag.phel"
				}
			},
			"end": "\"",
			"endCaptures": {
				"0": {
					"name": "punctuation.definition.string.end.phel"
				}
			},
			"patterns": [
				{
					"name": "constant.character.escape.phel",
					"match": "\\\\."
				}
			]
		},
		"short-fn": {
			"begin": "(#\\(|\\|\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.short-fn.begin.phel"
				}
			},
			"end": "(\\))",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.short-fn.end.phel"
				}
			},
			"name": "meta.short-fn.phel",
			"patterns": [
				{
					"name": "variable.parameter.positional.phel",
					"match": "%&|%[0-9]*|\\$&|\\$[0-9]*"
				},
				{
					"include": "#all"
				}
			]
		},
		"sets": {
			"begin": "(#\\{)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.set.begin.phel"
				}
			},
			"end": "(\\})",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.set.end.phel"
				}
			},
			"name": "meta.set.phel",
			"patterns": [
				{
					"include": "#all"
				}
			]
		},
		"braces": {
			"begin": "(\\@?\\{)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.braces.begin.phel"
				}
			},
			"end": "(\\})",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.braces.end.phel"
				}
			},
			"name": "meta.expression.phel",
			"patterns": [
				{
					"include": "#all"
				}
			]
		},
		"brackets": {
			"begin": "(@?\\[)",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.bracket.begin.phel"
				}
			},
			"end": "(\\])",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.bracket.end.phel"
				}
			},
			"patterns": [
				{
					"include": "#all"
				}
			]
		},
		"parens": {
			"begin": "(@?\\()",
			"beginCaptures": {
				"1": {
					"name": "punctuation.definition.parens.begin.phel"
				}
			},
			"end": "(\\))",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.parens.end.phel"
				}
			},
			"patterns": [
				{
					"include": "#all"
				}
			]
		},
		"multiline-comment": {
			"name": "comment.block.phel",
			"begin": "#\\|",
			"end": "\\|#"
		},
		"tagged-literal": {
			"comment": "`#inst`, `#uuid`, and EDN-style namespaced tags such as `#my.app/Person`.",
			"match": "(#)([a-zA-Z][\\w-]*(?:\\.[\\w-]+)*(?:/[a-zA-Z][\\w-]*(?:\\.[\\w-]+)*)?)",
			"captures": {
				"1": {
					"name": "punctuation.definition.tag.phel"
				},
				"2": {
					"name": "storage.type.tagged.phel"
				}
			}
		},
		"metadata": {
			"comment": "Type/metadata tags: ^int, ^\"?int\", ^:memoize, ^:async, ^:by-ref",
			"patterns": [
				{
					"match": "(\\^)(:[^\\s\\#\\(\\)\\{\\}\\[\\]\\'\\\"\\,\\`]+)",
					"captures": {
						"1": {
							"name": "punctuation.definition.tag.phel"
						},
						"2": {
							"name": "storage.type.tagged.phel"
						}
					}
				},
				{
					"match": "(\\^)([a-zA-Z][\\w-]*|\"[^\"]*\")",
					"captures": {
						"1": {
							"name": "punctuation.definition.tag.phel"
						},
						"2": {
							"name": "storage.type.tagged.phel"
						}
					}
				}
			]
		},
		"reader-conditional": {
			"begin": "(#\\?@?)(\\()",
			"beginCaptures": {
				"1": {
					"name": "keyword.other.reader-conditional.phel"
				},
				"2": {
					"name": "punctuation.definition.parens.begin.phel"
				}
			},
			"end": "(\\))",
			"endCaptures": {
				"1": {
					"name": "punctuation.definition.parens.end.phel"
				}
			},
			"name": "meta.reader-conditional.phel",
			"patterns": [
				{
					"include": "#all"
				}
			]
		},
		"comment": {
			"begin": "(?:;|#(?=\\s|$))",
			"beginCaptures": {
				"0": {
					"name": "punctuation.definition.comment.phel"
				}
			},
			"end": "$",
			"name": "comment.line.phel"
		},
		"strings": {
			"name": "string.quoted.double.phel",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.phel",
					"match": "\\\\."
				}
			]
		},
		"all": {
			"patterns": [
				{
					"include": "#multiline-comment"
				},
				{
					"include": "#comment"
				},
				{
					"include": "#regexp"
				},
				{
					"include": "#strings"
				},
				{
					"include": "#reader-conditional"
				},
				{
					"include": "#short-fn"
				},
				{
					"include": "#parens"
				},
				{
					"include": "#brackets"
				},
				{
					"include": "#braces"
				},
				{
					"include": "#sets"
				},
				{
					"include": "#tagged-literal"
				},
				{
					"include": "#metadata"
				},
				{
					"include": "#char"
				},
				{
					"include": "#readermac"
				},
				{
					"include": "#keysym"
				},
				{
					"include": "#literal"
				},
				{
					"include": "#number"
				},
				{
					"include": "#interop"
				},
				{
					"include": "#corelib"
				},
				{
					"include": "#symbol"
				}
			]
		},
		"interop": {
			"comment": "Clojure-style PHP interop, the only spelling Phel writes since 0.50 (docs/spec/language-surface.md, ADR 0007). The `php/->`, `php/::` and `php/new` forms these expand to stay in #corelib: they are the compilation target and remain legal, just deprecated as source. A class is recognised lexically, by an upper-case first segment, exactly as the analyzer does. A bare capitalised symbol is left alone, because a Phel `defstruct` / `definterface` name looks the same (`phel.router/Router`).",
			"patterns": [
				{
					"comment": "C/$prop - a static property read. The sigil is required here: in read position a bare name is the class constant, since PHP files constants and static properties separately.",
					"match": "(?<![\\w$.\\\\/-])((?:\\\\)?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(/)(\\$[A-Za-z_][A-Za-z0-9_]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "support.class.phel"
						},
						"2": {
							"name": "punctuation.accessor.phel"
						},
						"3": {
							"name": "variable.other.property.static.phel"
						}
					}
				},
				{
					"comment": "C/.m - an instance method as a function of its receiver.",
					"match": "(?<![\\w$.\\\\/-])((?:\\\\)?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(/)(\\.)([A-Za-z_][A-Za-z0-9_-]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "support.class.phel"
						},
						"2": {
							"name": "punctuation.accessor.phel"
						},
						"3": {
							"name": "punctuation.accessor.phel"
						},
						"4": {
							"name": "entity.name.function.interop.phel"
						}
					}
				},
				{
					"comment": "C/CONST - a class constant. Constant and static method share one spelling and are told apart by reflection at analysis time, so the grammar splits them the way PHP source does, on casing.",
					"match": "(?<![\\w$.\\\\/-])((?:\\\\)?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(/)([A-Z][A-Z0-9_]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "support.class.phel"
						},
						"2": {
							"name": "punctuation.accessor.phel"
						},
						"3": {
							"name": "constant.other.class.phel"
						}
					}
				},
				{
					"comment": "C/m - a static method, called `(C/m args)` or taken as a value.",
					"match": "(?<![\\w$.\\\\/-])((?:\\\\)?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(/)([A-Za-z_][A-Za-z0-9_-]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "support.class.phel"
						},
						"2": {
							"name": "punctuation.accessor.phel"
						},
						"3": {
							"name": "entity.name.function.interop.phel"
						}
					}
				},
				{
					"comment": "(C. args) - a constructor, the trailing-dot spelling of `(new C args)`.",
					"match": "(?<=\\()((?:\\\\)?[A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(\\.)(?=\\s|\\)|$)",
					"captures": {
						"1": {
							"name": "support.class.phel"
						},
						"2": {
							"name": "punctuation.accessor.phel"
						}
					}
				},
				{
					"comment": "(.-field obj) - a value member read.",
					"match": "(?<![\\w$.\\\\/-])(\\.-)([A-Za-z_][A-Za-z0-9_-]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "punctuation.accessor.phel"
						},
						"2": {
							"name": "variable.other.property.phel"
						}
					}
				},
				{
					"comment": "(.m obj args) - an instance method call. Listed after #number so a leading `.5` is already a decimal, and after `.-` so a field read is not chewed as a method named `-field`.",
					"match": "(?<![\\w$.\\\\/-])(\\.)([A-Za-z_][A-Za-z0-9_-]*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "punctuation.accessor.phel"
						},
						"2": {
							"name": "entity.name.function.interop.phel"
						}
					}
				},
				{
					"comment": "\\Foo.Bar - a class named with the explicit leading marker and no member access. Unambiguous, so it is safe to colour where a bare `Foo` is not.",
					"match": "(?<![\\w$.\\\\/-])(\\\\)([A-Z][A-Za-z0-9_]*(?:[.\\\\][A-Za-z0-9_]+)*)(?![A-Za-z0-9_-])",
					"captures": {
						"1": {
							"name": "punctuation.definition.class.phel"
						},
						"2": {
							"name": "support.class.phel"
						}
					}
				}
			]
		}
	},
	"scopeName": "source.phel"
}
